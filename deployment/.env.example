# Environment Configuration for BD Performance Dashboard Deployment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment mode
NODE_ENV=production

# Application URLs
APP_URL=http://localhost
API_BASE_URL=http://localhost/api

# =============================================================================
# ODOO CONNECTION SETTINGS
# =============================================================================

# Odoo server configuration
ODOO_URL=http://odoo:8069
ODOO_DB=postgres
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Odoo API settings
ODOO_TIMEOUT=30
ODOO_MAX_RETRIES=3

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# PostgreSQL configuration (for Odoo)
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# =============================================================================
# REDIS CACHE SETTINGS (Optional)
# =============================================================================

# Redis configuration for caching
REDIS_URL=redis://redis:6379
REDIS_TTL=3600
CACHE_ENABLED=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log levels: debug, info, warning, error, critical
LOG_LEVEL=info
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# CORS settings
CORS_ORIGINS=http://localhost,http://127.0.0.1
CORS_CREDENTIALS=true

# Security headers
SECURE_HEADERS=true
HSTS_ENABLED=true

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Backend workers
BACKEND_WORKERS=4
BACKEND_TIMEOUT=60

# Nginx settings
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================

# Health check settings
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Metrics collection
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# TIMEZONE SETTINGS
# =============================================================================

# Application timezone
TZ=Asia/Jakarta

# =============================================================================
# DASHBOARD SPECIFIC SETTINGS
# =============================================================================

# Data refresh intervals (in seconds)
DATA_REFRESH_INTERVAL=300
CACHE_REFRESH_INTERVAL=3600

# Dashboard features
ENABLE_REAL_TIME_UPDATES=true
ENABLE_EXPORT_FEATURES=true
ENABLE_ADVANCED_FILTERS=true

# =============================================================================
# DEVELOPMENT SETTINGS (for development environment only)
# =============================================================================

# Development mode settings (uncomment for development)
# NODE_ENV=development
# LOG_LEVEL=debug
# BACKEND_WORKERS=1
# CORS_ORIGINS=*
# CACHE_ENABLED=false
